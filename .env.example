# Copy this file to `.env` (`cp .env.example .env`): the application and
# docker-compose.yaml read it at startup.

# ┌─ Authentication ────────────────────────────────────────┐
# `dev`: development login (GET /dev/login), without identity provider.
# Anyone can log in as any user: NEVER USE IN PRODUCTION.
# `entra` (default if absent): Microsoft Entra ID, see section below.
# `dev` is provided here so forks can start without Entra credentials:
# any deployment requires `AUTH_MODE` unset or `entra` (see README checklist).
AUTH_MODE=dev

# Optional key required by development login (empty = open login).
# Ignored with AUTH_MODE=entra.
DEV_LOGIN_KEY=

# Allowed email domains, comma-separated.
ALLOWED_DOMAINS=epf.fr,epfedu.fr

# Session cookie signature key. Mandatory with AUTH_MODE=entra
# (the application refuses to start without it); in dev, empty = random key
# at each startup. Provide a long, random value, e.g.:
# python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=
# └──────────────────────────────────────────────────────┘

# ┌─ Microsoft Entra ID (required with AUTH_MODE=entra) ───────┐
# Leave commented in dev mode. Uncomment and fill the four
# variables for AUTH_MODE=entra: the application refuses to start if any
# of the first three are missing.
# ENTRA_CLIENT_ID=
# ENTRA_CLIENT_SECRET=
# ENTRA_TENANT_ID=
# REDIRECT_URI=https://[CHANGE_THIS]/auth/callback
# └───────────────────────────────────────────────────────┘

# ┌─ Database ───────────────────────────────────────────────────┐
# SQLite database folder (default: `database/` at project root).
# With docker compose, host folder mounted into the container.
LOCAL_DATABASE_DIR=
# └───────────────────────────────────────────────────────────────┘

# ┌─ LLM Summaries ──────────────────────────────────┐
# Default LLM provider API key. Empty: the application starts, but
# requested summaries are marked with a configuration error.
LLM_API_KEY=

# Set to 1 to launch the summaries daemon in parallel with uvicorn.
# Leave empty/absent in production (launch.sh manages it already).
RUN_SUMMARIES_DAEMON=
# └──────────────────────────────────────────────────────┘
